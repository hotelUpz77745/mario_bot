{
    "app": {
        "name": "ClavaTrading",
        "annualization_days": 365,
        "_desc_annualization_days": "Число торговых дней в году для аннуализации Sharpe и Calmar (365 для крипто 24/7, 252 для классических фьючерсов)"
    },
