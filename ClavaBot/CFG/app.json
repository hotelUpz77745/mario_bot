        "start_balance_usd": 10000.0,
        "_desc_start_balance_usd": "Стартовый баланс мок-брокера в USD (10000.0 = $10,000)",
        "leverage": 2,
        "_desc_leverage": "Кредитное плечо для мок-исполнения (2 = 2x, запас маржи чтобы 6 монет не блокировали друг друга)",
        "taker_fee_rate": 0.0005,
        "_desc_taker_fee_rate": "Комиссия taker как доля от единицы (0.0005 = 0.05%)"
    },
    "binance_futures": {
        "base_url": "https://fapi.binance.com",
        "_desc_base_url": "REST-адрес Binance USD-M Futures (боевой или testnet https://testnet.binancefuture.com)",
        "ws_url": "wss://fstream.binance.com",
        "_desc_ws_url": "WebSocket-адрес Binance USD-M Futures",
        "api_key_env": "BINANCE_FAPI_KEY",
        "_desc_api_key_env": "Имя переменной окружения с API-ключом Binance Futures",
        "api_secret_env": "BINANCE_FAPI_SECRET",
        "_desc_api_secret_env": "Имя переменной окружения с секретным ключом Binance Futures",
        "recv_window_ms": 5000,
        "_desc_recv_window_ms": "Окно валидности подписанного запроса в миллисекундах (5000 = 5 сек)",
        "timeout_sec": 10.0,
        "_desc_timeout_sec": "Таймаут HTTP-запросов к Binance REST в секундах",
        "leverage": 2,
        "_desc_leverage": "Боевое кредитное плечо на фьючерсном аккаунте (2 = 2x)",
        "margin_type": "CROSSED",
        "_desc_margin_type": "Режим маржи на Binance Futures: 'CROSSED' или 'ISOLATED'",
        "working_type": "MARK_PRICE",
        "_desc_working_type": "Цена триггера биржевого STOP_MARKET: 'MARK_PRICE' или 'CONTRACT_PRICE'",
        "warmup_days": 220,
        "_desc_warmup_days": "Обязательный исторический прогрев в календарных днях при старте (220 >= 20d ret + 180d GMM + 15d Markov)",
        "dry_run": true,
        "_desc_dry_run": "true = безопасный сухой режим без реальных ордеров; false = реальные ордера на Binance Futures",
        "account_cache_ttl_sec": 5.0,
        "_desc_account_cache_ttl_sec": "Время кэширования баланса/маржи с /fapi/v2/account в секундах",
        "entry_delay_sec": 0,
        "_desc_entry_delay_sec": "Опциональная задержка обработки закрытия 4H свечи в секундах (0 = немедленно)"
    },
